# Edgefolio environment variables
#
# Copy this file to `.env.local` and fill in the Supabase publishable/anon key.
# Find it in the Supabase dashboard under Project Settings -> API.
#
# NEVER put a service_role/secret key in a NEXT_PUBLIC_* variable. Anything
# prefixed with NEXT_PUBLIC_ is exposed to the browser.

# Project URL and anon/publishable key from Supabase.
# If the host returns NXDOMAIN the project is paused or deleted — restore it in
# the Supabase dashboard (or create a new project) before auth can work.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Absolute origin used for OAuth/email redirect links. Set this to the public
# production domain (no trailing slash). When empty the request origin is used.
# Add https://<this-domain>/** to Supabase Authentication -> URL Configuration
# -> Redirect URLs, and use it as the Site URL.
NEXT_PUBLIC_SITE_URL=https://edgefolio-landing.vercel.app

# Server-only. NEVER prefix with NEXT_PUBLIC_.
# Used to resolve a username to its email during sign-in so the email never
# reaches the browser. Leave empty to disable username sign-in (email only).
SUPABASE_SERVICE_ROLE_KEY=

# Market pulse (Explore). Server-only: the key is used in a server-side fetch
# and never reaches the browser.
#
# MARKET_DATA_PROVIDER labels the source shown in the UI (default "Twelve Data").
# MARKET_DATA_API_KEY is required to turn live quotes on. Leave it empty and the
# Explore "Market Pulse" shows an honest "Not connected" state.
# MARKET_DATA_BASE_URL overrides the provider host (default https://api.twelvedata.com).
MARKET_DATA_PROVIDER=twelvedata
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=

# Market news (Explore). Public RSS/Atom feed, fetched server-side (no key).
# Defaults to the Cointelegraph feed when empty.
NEWS_FEED_URL=

# Economic calendar. Public Forex Factory weekly calendar feed (no key),
# fetched server-side and refreshed every 15 minutes. Leave empty to use the
# default feed. When it is unreachable the calendar shows an honest empty
# state instead of inventing events.
ECONOMIC_CALENDAR_URL=
